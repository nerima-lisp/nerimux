(require :asdf)

(setf asdf/source-registry:*source-registry*
      (make-hash-table :test (function equal)))

(let* ((root (first (uiop:split-string (uiop:getenv "NERIMUX_SIBLING_REGISTRY")
                                       :separator ":")))
       (path (merge-pathnames "cl-weave.asd"
                              (uiop:ensure-directory-pathname root))))
  (format t "Before forms~%")
  (finish-output)
  (with-open-file (stream path)
    (let ((*package* (find-package :asdf-user))
          (*load-truename* path)
          (*load-pathname* path))
      (read stream nil nil)
      (loop for form = (read stream nil nil)
            while form
            do (eval form))))
  (format t "After forms~%")
  (finish-output)
  (format t "Before posix~%")
  (finish-output)
  (require :sb-posix)
  (format t "After posix~%")
  (finish-output)
  (format t "Before load-system~%")
  (finish-output)
  (asdf:load-system "cl-weave")
  (format t "After load-system~%")
  (finish-output))
