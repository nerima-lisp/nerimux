(in-package #:nerimux/test)

(describe "server-multi-modal-stack-suite"
  (it "keeps Help under a quit confirmation and restores it after cancellation"
    (dolist (cancel-key '("q" "n"))
      (with-fake-session (session)
        (let ((conn (%make-test-conn :rows 40 :cols 110)))
          (labels ((visible-frame ()
                     (multiple-value-bind (type payload)
                         (decode-frame (nerimux::%render-client-frame session conn))
                       (expect (= +msg-frame+ type))
                       (strip-sgr (decode-text payload)))))
            (expect (null (nerimux::client-conn-modal conn)))
            (nerimux::%handle-multi-key-message session conn #(63))
            (expect (eq :transient (nerimux::client-conn-modal conn)))
            (nerimux::%handle-multi-key-message session conn #(107))
            (expect (eq :help (nerimux::client-conn-modal conn)))
            (let ((help-frame (visible-frame)))
              (expect (search "HELP" help-frame))
              (expect (search "Navigate" help-frame))
              (nerimux::%handle-multi-key-message session conn #(17))
              (expect (eq :help (nerimux::client-conn-modal conn)))
              (nerimux::%handle-multi-key-message session conn #(81))
              (expect (eq :confirm (nerimux::client-conn-modal conn)))
              (expect (nerimux::client-conn-confirm-view conn))
              (let ((confirm-frame (visible-frame)))
                (expect (search "Quit server" confirm-frame))
                (expect (search "HELP" confirm-frame))
                (expect (search "Navigate" confirm-frame))
                (nerimux::%handle-multi-key-message session conn cancel-key)
                (expect (eq :help (nerimux::client-conn-modal conn)))
                (expect (null (nerimux::client-conn-confirm-view conn)))
                (expect (equal help-frame (visible-frame)))))))))))
