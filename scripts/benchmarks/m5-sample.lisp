(require :asdf)

(defun m5-env (name)
  (or (uiop:getenv name) (error "missing environment variable ~A" name)))

(defun m5-write (path value)
  (uiop:write-file-string path value :if-exists :supersede))

(defun m5-uptime-load ()
  (let* ((output (uiop:run-program '("uptime") :output :string))
         (start (or (search "load averages:" output :test #'char-equal)
                    (search "load average:" output :test #'char-equal))))
    (unless start (error "uptime load averages are missing"))
    (let ((tail (subseq output (+ start (if (search "load averages:" output
                                               :test #'char-equal) 14 13))))
          (values nil))
      (loop with token-start = nil
            for index from 0 to (length tail)
            for character = (if (< index (length tail)) (char tail index) #\Space)
            do (if (find character '(#\Space #\Tab #\Newline #\Return #\, #\{ #\}))
                   (when token-start
                     (push (float (read-from-string
                                   (subseq tail token-start index)) 1d0) values)
                     (setf token-start nil))
                   (unless token-start (setf token-start index)))
            until (and (= index (length tail)) (>= (length values) 3)))
      (unless (= (length values) 3) (error "uptime load average count is not three"))
      (nreverse values))))

(defun m5-output-signature (text)
  (unless (and (stringp text) (plusp (length text)))
    (error "git-output-empty"))
  (list (length text) (sxhash text)))

(defun m5-load-ok-p (values)
  (and (= (length values) 3)
       (loop for value in values
             for limit in '(4d0 8d0 12d0)
             always (<= value limit))))

(defun m5-format-load (values)
  (format nil "~{~,2F~^,~}" values))

(defun m5-run ()
  (let* ((nerimux-system (asdf:find-system "nerimux" nil))
         (process-kit-system (asdf:find-system "cl-process-kit" nil))
         (nerimux-asd (and nerimux-system (asdf:system-source-file nerimux-system)))
         (process-kit-asd (and process-kit-system
                               (asdf:system-source-file process-kit-system)))
         (git-read (find-symbol "%RUN-GIT-READ" "NERIMUX/VCS"))
         (directory (m5-env "M5_TARGET")))
    (unless (and nerimux-asd process-kit-asd git-read (fboundp git-read))
      (error "loaded nerimux/process-kit sources or git-read function are missing"))
    (unless (uiop:directory-exists-p (uiop:ensure-directory-pathname directory))
      (error "shared Git worktree target is unavailable"))
    (format t "M5_PROVENANCE~C~A~C~A~%"
            #\Tab (namestring (truename nerimux-asd))
            #\Tab (namestring (truename process-kit-asd)))
    (finish-output)
    (when (equal (uiop:getenv "M5_PREFLIGHT_ONLY") "1")
      (format t "M5_PREFLIGHT=ok~%")
      (finish-output)
      (return-from m5-run nil))
    (let* ((warmup (funcall (symbol-function git-read)
                            directory "rev-parse" "--show-toplevel"))
           (warmup-signature (m5-output-signature warmup)))
      (m5-write (m5-env "M5_WARMUP_OUTPUT") warmup)
      (let* ((load-before (m5-uptime-load))
             (start nil)
             (output nil)
             (elapsed nil)
             (elapsed-ms nil)
             (load-after nil))
        (unless (m5-load-ok-p load-before)
          (setf load-after (m5-uptime-load))
          (format t "M5_REJECT~Cbefore~C~A~C~A~%"
                  #\Tab #\Tab (m5-format-load load-before)
                  #\Tab (m5-format-load load-after))
          (finish-output)
          (sb-ext:exit :code 2))
        (setf start (get-internal-real-time)
              output (funcall (symbol-function git-read)
                              directory "rev-parse" "--show-toplevel")
              elapsed (- (get-internal-real-time) start)
              elapsed-ms (* 1000d0 (/ elapsed internal-time-units-per-second))
              load-after (m5-uptime-load))
        (unless (equal (m5-output-signature output) warmup-signature)
          (error "warmup-and-measured-output-signatures-differ"))
        (m5-write (m5-env "M5_SAMPLE_OUTPUT") output)
        (format t "M5_SAMPLE~C~A~C~,6F~C~A~C~A~%"
                #\Tab (if (m5-load-ok-p load-after) "ok" "load-after-rejected")
                #\Tab elapsed-ms #\Tab (m5-format-load load-before)
                #\Tab (m5-format-load load-after))
        (finish-output)
        (unless (m5-load-ok-p load-after) (sb-ext:exit :code 2))))))

(handler-case
    (m5-run)
  (error (condition)
    (format *error-output* "M5_ERROR~C~A~%" #\Tab condition)
    (finish-output *error-output*)
    (sb-ext:exit :code 1)))
